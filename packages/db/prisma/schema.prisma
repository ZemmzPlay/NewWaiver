// Schema for carnival-waiver, straight from DATA_MODEL.md.
//
// Hard rule 3: every timestamp is `timestamptz` and every value written to one
// is an absolute instant in UTC. Nothing here stores a wall-clock time.
//
// Column/table names are pinned with @map/@@map to match the names the
// previous Drizzle schema already created — this is a driver swap, not a
// redesign. Three Postgres features below have no native Prisma DSL
// representation (the partial unique index on sessions, the partial index on
// notifications, and the two GIN trigram indexes) and are added by hand in
// the generated migration.sql instead — see prisma/migrations/*/migration.sql.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

/* ------------------------------------------------------------------ enums */

enum RelationType {
  mother
  father
  guardian
  other

  @@map("relation_type")
}

enum SupervisionMode {
  accompanied
  drop_off

  @@map("supervision_mode")
}

enum RegStatus {
  active
  void

  @@map("reg_status")
}

enum SessionStatus {
  active
  warned
  expired
  overdue
  checked_out
  cancelled

  @@map("session_status")
}

enum NotifType {
  registration
  expiry_warning
  pickup_request
  login_code

  @@map("notif_type")
}

/// whatsapp is reserved and unused this event - hard rule 6 keeps the seat warm.
enum NotifChannel {
  email
  whatsapp

  @@map("notif_channel")
}

enum NotifStatus {
  scheduled
  claimed
  sent
  delivered
  failed
  cancelled

  @@map("notif_status")
}

enum StaffRole {
  staffer
  pickup
  supervisor
  admin

  @@map("staff_role")
}

enum VerifyMethod {
  code
  qr
  name_match
  supervisor_override

  @@map("verify_method")
}

enum EmailStatus {
  unknown
  delivered
  bounced
  complained

  @@map("email_status")
}

enum PickupMethod {
  call
  whatsapp

  @@map("pickup_method")
}

enum PickupOutcome {
  answered
  no_answer
  on_the_way

  @@map("pickup_outcome")
}

enum PrintStatus {
  queued
  printed
  failed

  @@map("print_status")
}

/* ----------------------------------------------------------------- tables */

model Event {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  venue     String
  startsAt  DateTime @map("starts_at") @db.Timestamptz
  endsAt    DateTime @map("ends_at") @db.Timestamptz
  timezone  String   @default("Asia/Dubai")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  zones          Zone[]
  waiverVersions WaiverVersion[]
  guardians      Guardian[]
  registrations  Registration[]
  staff          Staff[]
  devices        Device[]
  auditLog       AuditLog[]

  @@map("events")
}

model Zone {
  id       String @id @default(uuid()) @db.Uuid
  eventId  String @map("event_id") @db.Uuid
  name     String
  /// The zone name in Arabic. A zone is data, so its name is data too — it
  /// cannot live in the interface dictionary, and it reaches emails and the
  /// counter as well as the page.
  nameAr           String?         @map("name_ar")
  supervisionMode  SupervisionMode @map("supervision_mode")
  capacity         Int?
  /// Null means no limit. Seeded null - PRD s2 is still [OPEN] on age limits.
  minAge    Int?     @map("min_age")
  maxAge    Int?     @map("max_age")
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  event    Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  packages Package[]
  devices  Device[]
  staff    Staff[]
  sessions Session[]

  @@map("zones")
}

model Package {
  id        String   @id @default(uuid()) @db.Uuid
  zoneId    String   @map("zone_id") @db.Uuid
  label     String
  minutes   Int
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  zone     Zone      @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  children Child[]
  sessions Session[]

  @@index([zoneId, sortOrder], map: "packages_zone_idx")
  @@map("packages")
}

/// Hard rule 7: publishing inserts, it never updates.
model WaiverVersion {
  id          String   @id @default(uuid()) @db.Uuid
  eventId     String   @map("event_id") @db.Uuid
  locale      String   @default("en")
  version     Int
  title       String
  bodyMd      String   @map("body_md")
  publishedAt DateTime @default(now()) @map("published_at") @db.Timestamptz
  isActive    Boolean  @default(true) @map("is_active")

  event    Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  consents Consent[]

  @@unique([eventId, locale, version], map: "waiver_versions_event_locale_version_key")
  @@map("waiver_versions")
}

model Guardian {
  id             String   @id @default(uuid()) @db.Uuid
  eventId        String   @map("event_id") @db.Uuid
  fullName       String   @map("full_name")
  relation       RelationType
  relationOther  String?  @map("relation_other")
  phoneE164      String   @map("phone_e164")
  /// Last 9 digits, so search matches however the staffer types the number.
  phoneTail            String    @map("phone_tail")
  email                String
  emailStatus          EmailStatus @default(unknown) @map("email_status")
  /// The language they filled the form in. Every email to them uses it.
  locale               String    @default("en")
  marketingConsent     Boolean   @default(false) @map("marketing_consent")
  marketingConsentAt   DateTime? @map("marketing_consent_at") @db.Timestamptz
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz

  event           Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations   Registration[]
  loginChallenges LoginChallenge[]

  @@unique([eventId, phoneE164], map: "guardians_event_phone_key")
  @@index([eventId, phoneTail], map: "guardians_event_tail_idx")
  @@map("guardians")
}

model Registration {
  id        String     @id @default(uuid()) @db.Uuid
  eventId   String     @map("event_id") @db.Uuid
  guardianId String    @map("guardian_id") @db.Uuid
  code      String
  status    RegStatus  @default(active)
  source    String     @default("web")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz

  event        Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guardian     Guardian      @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  children     Child[]
  consents     Consent[]
  notifications Notification[]

  @@unique([code], map: "registrations_code_key")
  @@index([guardianId], map: "registrations_guardian_idx")
  @@map("registrations")
}

model Child {
  id                 String   @id @default(uuid()) @db.Uuid
  registrationId     String   @map("registration_id") @db.Uuid
  fullName           String   @map("full_name")
  ageYears           Int      @map("age_years")
  medicalNotes       String?  @map("medical_notes")
  photoConsent       Boolean  @default(false) @map("photo_consent")
  childCode          String   @map("child_code")
  seq                Int
  /// The package the family picked online; the counter may still change it.
  requestedPackageId String?  @map("requested_package_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz

  registration     Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  requestedPackage Package?     @relation(fields: [requestedPackageId], references: [id])
  sessions         Session[]

  @@unique([childCode], map: "children_child_code_key")
  @@index([registrationId, seq], map: "children_registration_idx")
  @@map("children")
}

/// Append-only. The acceptance record the waiver exists to produce.
model Consent {
  id              String   @id @default(uuid()) @db.Uuid
  registrationId  String   @map("registration_id") @db.Uuid
  waiverVersionId String   @map("waiver_version_id") @db.Uuid
  acceptedAt      DateTime @default(now()) @map("accepted_at") @db.Timestamptz
  typedName       String   @map("typed_name")
  ip              String?
  userAgent       String?  @map("user_agent")

  registration  Registration  @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  waiverVersion WaiverVersion @relation(fields: [waiverVersionId], references: [id])

  @@map("consents")
}

model Staff {
  id             String    @id @default(uuid()) @db.Uuid
  eventId        String    @map("event_id") @db.Uuid
  fullName       String    @map("full_name")
  role           StaffRole @default(staffer)
  pinHash        String    @map("pin_hash")
  defaultZoneId  String?   @map("default_zone_id") @db.Uuid
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  event               Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  defaultZone         Zone?     @relation(fields: [defaultZoneId], references: [id])
  startedSessions     Session[] @relation("SessionStartedByStaff")
  checkedOutSessions  Session[] @relation("SessionCheckedOutByStaff")
  pickupAttempts      PickupAttempt[]
  prints              Print[]

  @@map("staff")
}

model Device {
  id            String    @id @default(uuid()) @db.Uuid
  eventId       String    @map("event_id") @db.Uuid
  label         String
  zoneId        String?   @map("zone_id") @db.Uuid
  printAgentUrl String?   @map("print_agent_url")
  printerIp     String?   @map("printer_ip")
  lastSeenAt    DateTime? @map("last_seen_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz

  event  Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  zone   Zone?   @relation(fields: [zoneId], references: [id])
  prints Print[]

  @@map("devices")
}

model Session {
  id                  String        @id @default(uuid()) @db.Uuid
  childId             String        @map("child_id") @db.Uuid
  zoneId              String        @map("zone_id") @db.Uuid
  packageId           String        @map("package_id") @db.Uuid
  minutes             Int
  startedByStaffId    String?       @map("started_by_staff_id") @db.Uuid
  startedAt           DateTime      @map("started_at") @db.Timestamptz
  endsAt              DateTime      @map("ends_at") @db.Timestamptz
  warnAt              DateTime      @map("warn_at") @db.Timestamptz
  status              SessionStatus @default(active)
  stubRef             String?       @map("stub_ref")
  checkedOutAt        DateTime?     @map("checked_out_at") @db.Timestamptz
  checkedOutByStaffId String?       @map("checked_out_by_staff_id") @db.Uuid
  /// Null when the registered guardian collected. A name only on an override.
  releasedTo          String?       @map("released_to")
  verifyMethod        VerifyMethod? @map("verify_method")
  extendsSessionId    String?       @map("extends_session_id") @db.Uuid
  /// Hard rule 5: every session write carries this and is safe to replay.
  clientUuid          String        @unique(map: "sessions_client_uuid_key") @map("client_uuid") @db.Uuid
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz

  child            Child           @relation(fields: [childId], references: [id], onDelete: Cascade)
  zone             Zone            @relation(fields: [zoneId], references: [id])
  package          Package         @relation(fields: [packageId], references: [id])
  startedByStaff   Staff?          @relation("SessionStartedByStaff", fields: [startedByStaffId], references: [id])
  checkedOutByStaff Staff?         @relation("SessionCheckedOutByStaff", fields: [checkedOutByStaffId], references: [id])
  notifications    Notification[]
  pickupAttempts   PickupAttempt[]
  prints           Print[]

  // The partial unique index enforcing "one live session per child" is added
  // by hand in migration.sql — Prisma's schema DSL has no WHERE-clause index.
  @@index([zoneId, status, endsAt], map: "sessions_zone_status_ends_idx")
  @@index([childId], map: "sessions_child_idx")
  @@map("sessions")
}

model Notification {
  id                 String       @id @default(uuid()) @db.Uuid
  sessionId          String?      @map("session_id") @db.Uuid
  registrationId     String       @map("registration_id") @db.Uuid
  type               NotifType
  channel            NotifChannel @default(email)
  toAddress          String       @map("to_address")
  scheduledFor       DateTime     @map("scheduled_for") @db.Timestamptz
  claimedAt          DateTime?    @map("claimed_at") @db.Timestamptz
  sentAt             DateTime?    @map("sent_at") @db.Timestamptz
  providerMessageId  String?      @map("provider_message_id")
  status             NotifStatus  @default(scheduled)
  error              String?
  attempts           Int          @default(0)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz

  session      Session?     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  // The partial index the worker claims off (`WHERE status = 'scheduled'`) is
  // added by hand in migration.sql — hard rule 4, it has to stay cheap.
  @@index([sessionId, type], map: "notifications_session_idx")
  @@map("notifications")
}

model PickupAttempt {
  id          String        @id @default(uuid()) @db.Uuid
  sessionId   String        @map("session_id") @db.Uuid
  staffId     String?       @map("staff_id") @db.Uuid
  attemptedAt DateTime      @default(now()) @map("attempted_at") @db.Timestamptz
  method      PickupMethod
  outcome     PickupOutcome
  note        String?

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  staff   Staff?  @relation(fields: [staffId], references: [id])

  @@index([sessionId, attemptedAt], map: "pickup_attempts_session_idx")
  @@map("pickup_attempts")
}

model Print {
  id          String      @id @default(uuid()) @db.Uuid
  sessionId   String      @map("session_id") @db.Uuid
  staffId     String?     @map("staff_id") @db.Uuid
  deviceId    String?     @map("device_id") @db.Uuid
  copyNo      Int         @default(1) @map("copy_no")
  payloadHash String      @map("payload_hash")
  printedAt   DateTime?   @map("printed_at") @db.Timestamptz
  status      PrintStatus @default(queued)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  staff   Staff?  @relation(fields: [staffId], references: [id])
  device  Device? @relation(fields: [deviceId], references: [id])

  @@map("prints")
}

/// One-time codes for the "open my page again" flow.
///
/// A guardian who has lost their link types their mobile number; we email a
/// six-digit code to the address already on file and let them back into their
/// own page. The number alone is never enough — it is written on a sticker and
/// said out loud at a counter all day — so possession of the mailbox is what
/// actually authorises.
///
/// The code is stored hashed. `attempts` is checked before every comparison, so
/// a million-guess script gets five tries and then a dead row.
model LoginChallenge {
  id          String    @id @default(uuid()) @db.Uuid
  guardianId  String    @map("guardian_id") @db.Uuid
  codeHash    String    @map("code_hash")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  attempts    Int       @default(0)
  consumedAt  DateTime? @map("consumed_at") @db.Timestamptz
  requestedIp String?   @map("requested_ip")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@index([guardianId, createdAt], map: "login_challenges_guardian_idx")
  @@map("login_challenges")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String?  @map("event_id") @db.Uuid
  actorType String   @map("actor_type")
  actorId   String?  @map("actor_id") @db.Uuid
  action    String
  entity    String
  entityId  String?  @map("entity_id") @db.Uuid
  meta      Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  event Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([entity, entityId], map: "audit_log_entity_idx")
  @@map("audit_log")
}
