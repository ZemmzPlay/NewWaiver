{
  "name": "@carnival/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./env": "./src/env.ts"
  },
  "scripts": {
    "postinstall": "prisma generate --schema=./prisma/schema.prisma",
    "generate": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate": "dotenv -e ../../.env -- prisma migrate deploy",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "seed": "tsx src/seed.ts",
    "reset": "tsx src/reset.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@carnival/shared": "*",
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "dotenv": "^16.4.5",
    "dotenv-cli": "^7.4.4",
    "prisma": "6.19.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
