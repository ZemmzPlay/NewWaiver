# ---------------------------------------------------------------- database
# Local: a Postgres you already have. Production: the RDS endpoint in ap-south-1.
# Prisma reads pool size and SSL mode from the URL itself rather than separate
# env vars — e.g. add ?connection_limit=10&sslmode=require in production.
# Matches docker-compose.yml (docker compose up -d).
DATABASE_URL=postgres://carnival:carnival@localhost:5432/carnival_waiver

# ------------------------------------------------------------------ public
# Used in emails and QR codes, so it has to be the URL a phone can actually open.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --------------------------------------------------------------- messaging
# console | sendgrid
MESSAGING_PROVIDER=console
MESSAGING_FROM=Carnival <no-reply@thecarnival.ae>

# sendgrid
SENDGRID_API_KEY=
# Verifies POST /api/webhooks/sendgrid — SendGrid signs each event payload
# with this key (Event Webhook settings > Signed Event Webhook Requests).
SENDGRID_WEBHOOK_SIGNING_KEY=

# ------------------------------------------------------------------ counter
# The counter console will not open without this. Set it per device.
STAFF_DEVICE_TOKEN=change-me
# Local print agent on the counter laptop. Blank disables the ZPL path and
# leaves the browser fallback, which is the documented degraded mode.
NEXT_PUBLIC_PRINT_AGENT_URL=http://localhost:9110

# --------------------------------------------------------------- print agent
PRINT_AGENT_PORT=9110
PRINTER_IP=192.168.8.20
PRINTER_PORT=9100
# Set to true to log ZPL instead of opening a socket, for a laptop with no printer.
PRINT_AGENT_DRY_RUN=true
